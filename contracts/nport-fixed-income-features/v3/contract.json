  "coverage": {
    "unit": "ratio in [0,1]",
    "denominator": "sum(abs(signed_market_value)) of the applicable resolved positions with known market value; sensitivity normalization separately requires nonzero NET_ASSETS",
    "numerator": "sum(abs(signed_market_value)) of denominator positions carrying the named governed field",
    "exclusions": [
      "unresolved bridge rows",
      "unknown signed_market_value",
      "missing or invalid source fields"
    ],
    "null_policy": "A metric is null when its denominator is unavailable; an unavailable source capability is never zero-filled."
  },
