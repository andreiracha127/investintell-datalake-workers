# open_macro v4 pinned fixtures — the golden ledger sha256 is over raw bytes
tests/fixtures/open_macro_v4/** text eol=lf

# open_macro_v03 decision-chain producer fixtures — a READ-ONLY capture of the live
# certified chain and of the live vintage/price delta. The golden replay compares
# against these values cell by cell, so the bytes must not be rewritten on checkout.
tests/fixtures/open_macro_v03_chain/** text eol=lf

# N-PORT DERA slice — carved verbatim from a real quarterly package; the tests
# pin exact row and ISIN counts, so the bytes must not be rewritten on checkout.
tests/fixtures/nport_dera/** text eol=lf

# Public bond default-event contracts and fixtures — digests are pinned over the raw
# bytes. The SEC EDGAR header pages and N-PORT XML are copied verbatim from sec.gov,
# so their trailing whitespace is part of the evidence and must not be "fixed".
contracts/bonds/** text eol=lf
tests/fixtures/bond_default_events/** text eol=lf
tests/fixtures/bond_default_events/edgar/*.html -whitespace
tests/fixtures/bond_default_events/nport/*.xml -whitespace
tests/fixtures/bond_default_events/ncen/**/*.tsv -whitespace
tests/fixtures/bond_default_events/ncen/xml/*.xml -whitespace
configs/bond_default_events/** text eol=lf

# Owner-adjudicated legal-default evidence (bond_default_owner_evidence_v1). Kept OUTSIDE
# contracts/bonds and src/bonds/default_events on purpose: those trees are hashed into the
# legacy bond_default_events code digest that committed invocation manifests pin, so a new
# product placed there would silently invalidate a pinned legacy identity.
contracts/bond_default_owner_evidence/** text eol=lf

# bond-live-daily pinned image: the lock/Dockerfile sha256 recorded in every build
# manifest and determinism receipt is over the raw bytes, so checkouts must not
# rewrite line endings (the image is built from a Linux checkout).
docker/bond-live-daily/** text eol=lf
